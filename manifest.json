{
  "manifest_version": 3,
  "name": "Gemini Remielle Virtual Assistant",
  "version": "1.0",
  "description": "Displays Remielle GIF depending on conversation state in Gemini.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": ["https://gemini.google.com/*"]
    }
  ]
}